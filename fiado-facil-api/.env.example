# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET=seu_jwt_secret_aqui_troque_em_producao
JWT_EXPIRATION=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fiado_user
DB_PASSWORD=fiado_pass
DB_DATABASE=fiado_facil
DB_SYNCHRONIZE=true
DB_LOGGING=false

# WhatsApp Business API (Evolution API ou Z-API)
WHATSAPP_API_URL=https://sua-instancia.evolution.api
WHATSAPP_API_KEY=sua_api_key
WHATSAPP_INSTANCE=sua_instancia

# PIX (para futuras integrações)
PIX_KEY=seu_cpf_ou_cnpj_ou_email

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
