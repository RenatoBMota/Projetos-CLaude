generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUnidade {
  MATRIZ
  FILIAL
}

enum Perfil {
  ADMINISTRADOR
  SUPERVISOR
  LIDER_LOJA
  OPERADOR
  SEPARADOR
  CONFERENTE
  ANALISTA
  AUDITORIA
}

enum StatusTransferencia {
  PENDENTE_SEPARACAO
  EM_SEPARACAO
  CARREGADO
  EM_TRANSITO
  RECEBIDO
  CONFERIDO_OK
  CONFERIDO_DIVERGENTE
  FINALIZADO
  CANCELADO
}

enum TipoDivergencia {
  FALTOU
  SOBROU
  QUEBRADO
  PRODUTO_ERRADO
}

enum TipoEvento {
  UPLOAD
  SEPARACAO
  CARREGAMENTO
  RECEBIMENTO
  CONFERENCIA
  CANCELAMENTO
  PONTO_CONTROLE
}

enum Prioridade {
  NORMAL
  URGENTE
}

enum StatusTratativa {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
}

model Unidade {
  id           String      @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String      @unique
  tipo         TipoUnidade
  ativa        Boolean     @default(true)

  usuarios              UsuarioUnidade[]
  rotasOrigem           RotaSLA[]        @relation("RotaOrigem")
  rotasDestino          RotaSLA[]        @relation("RotaDestino")
  transferenciasOrigem  Transferencia[]  @relation("TransferenciaOrigem")
  transferenciasDestino Transferencia[]  @relation("TransferenciaDestino")

  createdAt DateTime @default(now())
}

model Usuario {
  id                    String            @id @default(cuid())
  nome                  String
  email                 String            @unique
  senhaHash             String
  perfil                Perfil
  ativo                 Boolean           @default(true)
  unidades              UsuarioUnidade[]
  eventos               EventoAuditoria[]
  tratativasResponsavel Transferencia[]   @relation("TratativaResponsavel")
  createdAt             DateTime          @default(now())
}

model UsuarioUnidade {
  usuarioId String
  unidadeId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  @@id([usuarioId, unidadeId])
  @@index([unidadeId])
}

model Transportadora {
  id        String   @id @default(cuid())
  nome      String   @unique
  cnpj      String?
  telefone  String?
  ativa     Boolean  @default(true)

  transferencias Transferencia[]

  createdAt DateTime @default(now())
}

model RotaSLA {
  id         String  @id @default(cuid())
  origemId   String
  destinoId  String
  origem     Unidade @relation("RotaOrigem", fields: [origemId], references: [id])
  destino    Unidade @relation("RotaDestino", fields: [destinoId], references: [id])
  prazoHoras Int

  @@unique([origemId, destinoId])
}

model Transferencia {
  id            String              @id @default(cuid())
  numeroNF      String
  serie         String
  numeroPedido  String
  origemId      String
  destinoId     String
  origem        Unidade             @relation("TransferenciaOrigem", fields: [origemId], references: [id])
  destino       Unidade             @relation("TransferenciaDestino", fields: [destinoId], references: [id])
  dataPedido    DateTime
  dataEmissao   DateTime
  // Falso quando a hora de dataEmissao não veio de fonte confiável (ex.: OCR sem
  // o horário do protocolo de autorização) — nesse caso a UI mostra só a data.
  dataEmissaoConfiavel Boolean @default(true)
  valorTotal    Decimal             @db.Decimal(14, 2)
  qtdVolumes    Int
  pesoBruto     Decimal             @db.Decimal(12, 3)
  qtdSku        Int
  qtdItensTotal Int
  status        StatusTransferencia @default(PENDENTE_SEPARACAO)
  prioridade    Prioridade          @default(NORMAL)

  transportadoraId String?
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id])
  valorFrete       Decimal?        @db.Decimal(12, 2)
  veiculo          String?
  motorista        String?
  viagemNumero     String?
  numeroBonus      String?
  prazoPrevisto    DateTime

  dataSeparacaoConcluida DateTime?
  dataCarregamento       DateTime?
  dataRecebimento        DateTime?
  dataConferencia        DateTime?
  dataFinalizacao        DateTime?

  // Tratativa da divergência: fechamento de loop depois que a conferência aponta problema.
  tratativaStatus        StatusTratativa?
  tratativaResponsavelId String?
  tratativaResponsavel   Usuario?         @relation("TratativaResponsavel", fields: [tratativaResponsavelId], references: [id])
  tratativaPrazo         DateTime?
  tratativaObservacao    String?

  // Devolução: transferência reversa criada a partir de uma divergência (sobrou/quebrado).
  transferenciaOrigemId String?
  transferenciaOrigem   Transferencia?  @relation("Devolucao", fields: [transferenciaOrigemId], references: [id])
  devolucoes            Transferencia[] @relation("Devolucao")

  xmlOriginal String?

  itens   ItemTransferencia[]
  eventos EventoAuditoria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([numeroNF, serie, origemId])
  @@index([origemId, status])
  @@index([destinoId, status])
}

model ItemTransferencia {
  id              String        @id @default(cuid())
  transferenciaId String
  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id])
  codigoInterno   String
  descricao       String
  ncm             String
  cfop            String
  quantidade      Int

  separado Boolean @default(false)

  quantidadeConferida Int?
  divergenciaTipo     TipoDivergencia?
  divergenciaQtd      Int?
  divergenciaObs      String?
  divergenciaFotos    String[]

  @@index([transferenciaId])
}

model EventoAuditoria {
  id              String        @id @default(cuid())
  transferenciaId String
  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id])
  tipo            TipoEvento
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  dataHora        DateTime      @default(now())
  observacao      String?
  fotos           String[]

  @@index([transferenciaId])
}
