# Mercado Livre API
ML_CLIENT_ID=SEU_CLIENT_ID
ML_CLIENT_SECRET=SEU_CLIENT_SECRET
ML_AFFILIATE_ID=SEU_AFFILIATE_ID

# Configurações de busca
# Desconto mínimo para postar (%)
MIN_DISCOUNT_PERCENT=30

# Categorias para buscar (separadas por vírgula, vazio = todas)
# Exemplos: MLB1051 (Celulares), MLB1055 (Computadores), MLB1648 (TV)
CATEGORIES=

# Máximo de produtos por ciclo
MAX_PRODUCTS_PER_RUN=5

# Intervalo em minutos entre verificações
CRON_INTERVAL_MINUTES=30

# WhatsApp - IDs dos grupos (separados por vírgula)
# Para descobrir o ID do grupo, veja as instruções no README
WHATSAPP_GROUP_IDS=

# Horário de silêncio (não envia mensagens fora desse intervalo)
# Formato HH:MM
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
